import sys
def generate_and_check_workout():
    print(" ВЕЛОТРЕНАЖЕР: ПЛАНУВАЛЬНИК ")
    try:
        start_watt = int(input("1. Введіть початкове навантаження (Вт): "))
        days = int(input("2. Введіть тривалість курсу (днів): "))
        step = int(input("3. Введіть крок зміни навантаження (Вт, напр. 10): "))

        if days < 2:
            print("\nПомилка: Для графіка потрібно хоча б 2 дні.")
            return
        
        plan = []
        mid = days // 2
        current_load = start_watt

        for day in range(1, days + 1):
            plan.append(current_load)
            if day < mid + (days % 2): 
                current_load += step
            elif day >= mid + (days % 2) and day < days:
                current_load -= step

        print(f"{'ДЕНЬ':<10} | {'НАВАНТАЖЕННЯ':<12}")
    
        for i, watt in enumerate(plan, 1):
            print(f"День {i:<5} | {watt:>3} Вт")
        
        is_valid = True
        for i in range(mid):
            if plan[i] >= plan[i+1] and i+1 <= mid:
                is_valid = False
        for i in range(mid, days - 1):
            if plan[i] <= plan[i+1]:
                is_valid = False
        if is_valid:
            print("\nСТАТУС ПЛАНУ: [ OK ]")
            print("Графік відповідає нормі.")
        else:
            print("\nСТАТУС ПЛАНУ: [ NOT OK ]")
            print("Графік порушує логіку тренування.")

    except ValueError:
        print("\nПомилка: Будь ласка, вводьте лише цілі числа.")

if __name__ == "__main__":
    generate_and_check_workout()
